# Stranger Builds 2026 - Agent Configuration
# Copy this file to .env and fill in required values

# Agent Identity and Network
AGENT_NAME=stranger_builds_primary_agent
AGENT_SEED=
AGENT_PORT=8000
AGENT_ENDPOINT=
AGENT_NETWORK=mainnet
AGENT_VERSION=0.2.0
AGENT_DESCRIPTION=Stranger Builds 2026 Autonomous Multi-Agent Execution System

# Agentverse Credentials & Mailbox (Optional for local testing, required for Agentverse Mailbox)
AGENTVERSE_API_KEY=
AGENTVERSE_MAILBOX_KEY=
AGENTVERSE_URL=https://agentverse.ai

# Operational Settings
LOG_LEVEL=INFO
MESSAGE_DEDUPLICATION_TTL_SECONDS=3600
SESSION_EXPIRY_SECONDS=86400

# -------------------------------------------------------------
# PHASE 2: ASI-1 Primary Reasoning Engine
# -------------------------------------------------------------
ASI1_API_KEY=
ASI1_API_BASE=https://api.asi1.ai/v1
ASI1_MODEL=asi1-mini

# -------------------------------------------------------------
# PHASE 2: Database & Caching Infrastructure
# -------------------------------------------------------------
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stranger_builds
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------
# PHASE 2: Model Context Protocol (MCP) & External APIs
# -------------------------------------------------------------
MCP_SERVER_ENDPOINT=
MCP_AUTH_TOKEN=
